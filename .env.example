# Rename this to .env

# Data source
TMDB_API_KEY=="***********"
TMDB_API_URL="https://api.themoviedb.org"

# Auth
NEXTAUTH_SECRET="***********"
NEXTAUTH_URL="***********"
GOOGLE_ID="***********"
GOOGLE_SECRET="***********"

# Database (Neon Postgres — run `neon link` to generate this)
DATABASE_URL="***********"

# Outgoing mail for email verification. Optional: with no SMTP_HOST set,
# the app auto-generates a disposable Ethereal test inbox and logs a
# preview URL to the server console instead of sending real email.
SMTP_HOST="***********"
SMTP_PORT="587"
SMTP_USER="***********"
SMTP_PASS="***********"
SMTP_FROM="***********"
